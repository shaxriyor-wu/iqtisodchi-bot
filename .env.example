# --- Telegram ---
BOT_TOKEN=

# Botdan foydalana oladigan Telegram username'lar (vergul bilan, @siz) va/yoki ID'lar
ALLOWED_USERNAMES=
ALLOWED_USER_IDS=
# Ruxsatsiz foydalanuvchilar ruxsat so'rash uchun bog'lanadigan username (@siz)
ACCESS_CONTACT=

# --- PostgreSQL ---
POSTGRES_USER=iqtisodchi
POSTGRES_PASSWORD=change_me_long_random
POSTGRES_DB=iqtisodchi
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- AI ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# RAG embeddings: "voyage" (voyageai.com kaliti kerak) yoki bo'sh = lug'at filtri
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=

# --- Limits (default qiymatlar, bot ichidan o'zgartiriladi) ---
DEFAULT_DAILY_LIMIT=0
DEFAULT_CURRENCY=UZS
TIMEZONE=Asia/Tashkent

# --- Rate limiting ---
RATE_LIMIT_PER_SECOND=5
RATE_LIMIT_AI_PER_HOUR=60
MAX_MESSAGE_LENGTH=1000
# Javobdan keyin sizning xabaringiz va eski bot xabarlari o'chiriladi (chat toza qoladi)
DELETE_USER_MESSAGES=true

LOG_LEVEL=INFO
